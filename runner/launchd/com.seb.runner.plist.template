<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.seb.runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{MAIN}}/runner/run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{MAIN}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{PATH}}</string>
        <key>BOT_PYTHON</key>
        <string>{{BOT_PYTHON}}</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.seb-runner/logs/runner.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.seb-runner/logs/runner.launchd.err.log</string>
</dict>
</plist>
