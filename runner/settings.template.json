{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Edit(/{{MAIN}}/**)",
      "Edit(/{{SNAPSHOT}}/**)",
      "Edit(/{{HOME}}/.seb-runner/**)",
      "Edit(/{{HOME}}/.ssh/**)",
      "Edit(/{{HOME}}/.aws/**)",
      "Edit(/{{HOME}}/.config/**)",
      "Edit(/{{HOME}}/.hermes/**)",
      "Edit(/{{HOME}}/.claude/**)",
      "Read(/{{MAIN}}/**)",
      "Read(/{{HOME}}/.seb-runner/**)",
      "Read(/{{HOME}}/.ssh/**)",
      "Read(/{{HOME}}/.aws/**)",
      "Read(/{{HOME}}/.config/**)",
      "Read(/{{HOME}}/.hermes/**)",
      "Bash(git push *)",
      "Bash(git remote *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "{{MAIN}}",
        "{{HOME}}/.seb-runner",
        "{{HOME}}/.ssh",
        "{{HOME}}/.aws",
        "{{HOME}}/.config",
        "{{HOME}}/.hermes"
      ]
    },
    "network": {
      "allowedDomains": ["pypi.org", "files.pythonhosted.org"]
    }
  }
}
